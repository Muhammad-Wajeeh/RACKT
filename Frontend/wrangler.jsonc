{
  // Cloudflare deploy config. The name must match the Cloudflare project name.
  "name": "rackt",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (like a refresh on /closet) get index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
